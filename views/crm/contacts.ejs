<%- include('../partials/html') %>

<head>
  <%- include('../partials/title-meta', { title: "Contacts" }) %>
  <%- include('../partials/head-css') %>
</head>

<body>
<div class="wrapper">
  <%- include('../partials/menu') %>

  <div class="page-content">
    <div class="container-fluid">

      <div class="row mb-3">
        <div class="col-12 d-flex justify-content-between align-items-center">
          <h4 class="page-title">Contacts</h4>
          <a href="/crm/contacts/new" class="btn btn-primary">
            <i class="ti ti-plus"></i> New Contact
          </a>
        </div>
      </div>

      <div class="card">
        <div class="card-body">
          <table class="table table-hover">
            <thead>
              <tr>
                <th>Name</th>
                <th>Type</th>
                <th>Mobile</th>
                <th>Email</th>
              </tr>
            </thead>
            <tbody id="contactsTable"></tbody>
          </table>
        </div>
      </div>

    </div>
  </div>

  <%- include('../partials/footer') %>
</div>

<%- include('../partials/footer-scripts') %>

<script src="/js/components/crm/contact-storage.js"></script>
<script src="/js/pages/crm/contacts-lists.js"></script>

</body>
</html>
